{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiSkills": false,
  "env": {
    "DISABLE_AUTOUPDATER": "0",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/repos/nikbrunner/agents/mods/dash:~/repos/nikbrunner/agents/mods/play",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "1",
    "ELEVENLABS_API_KEY_COMMAND": "pass-cli item view pass://Nik/.env/ELEVENLABS_API_TOKEN",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(claude mcp list:*)",
      "Bash(claude mcp tools:*)",
      "Bash(curl:*)",
      "Bash(cut:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(grep:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run check:lint:*)",
      "Bash(npm run check:types:*)",
      "Bash(npm run db:push:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run format:*)",
      "Bash(npm run storybook:start:*)",
      "Bash(npm run test:*)",
      "Bash(npm run test:compile:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(npx shadcn@latest init --yes)",
      "Bash(npx supabase --help:*)",
      "Bash(npx supabase db --help:*)",
      "Bash(npx supabase link --help:*)",
      "Bash(pkill:*)",
      "Bash(timeout 10 npm run dev:*)",
      "Bash(timeout 5 npm run dev:*)",
      "Bash(timeout 8 npm run dev:*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__Ref__ref_read_url",
      "mcp__Ref__ref_search_documentation",
      "mcp__plugin_mcp_chrome-devtools__*",
      "mcp__plugin_mcp_exa__*",
      "mcp__linear__*",
      "mcp__plugin_mcp_atlassian-rovo-mcp__*",
      "mcp__supabase__*"
    ],
    "deny": [],
    "ask": []
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [],
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"allow\"}}'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce/session-start.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce/record-repo-root.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce/record-repo-root.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce/repair-core-bare.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce/ticket-titles.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce/skills-check.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce/current-datetime.sh"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/repos/nikbrunner/agents/statusline/post-tool-batch.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/repos/nikbrunner/agents/statusline/subagent-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/brunner/skills/tldraw-offline/inject-server-context.mjs' SubagentStart"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/repos/nikbrunner/agents/statusline/claude-subagent-statusline"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "storybook@storybook": true,
    "vercel@claude-plugins-official": true,
    "cache-tax@claude-code-mods": true,
    "clangd-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "mcp@nbr": true
  },
  "extraKnownMarketplaces": {
    "nbr": {
      "source": {
        "source": "directory",
        "path": "/Users/brunner/repos/nikbrunner/agents"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "readwise-skills": {
      "source": {
        "source": "github",
        "repo": "readwiseio/readwise-skills"
      }
    },
    "storybook": {
      "source": {
        "source": "github",
        "repo": "storybookjs/mcp",
        "ref": "main"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "gvzdv-plugins": {
      "source": {
        "source": "github",
        "repo": "gvzdv/claudish-to-english"
      }
    },
    "claude-code-filetree": {
      "source": {
        "source": "github",
        "repo": "data-goblin/claude-code-filetree"
      }
    },
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "karanb192/claude-code-mods"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "promptCacheTtl": "1h",
  "alwaysThinkingEnabled": false,
  "advisorModel": "fable",
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoDreamEnabled": true,
  "theme": "custom:black-atom",
  "editorMode": "vim",
  "idleCompaction": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: nikbrunner/dots is PUBLIC (confirmed via gh) — treat any content pushed here as published; out-of-place publication applies",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: Proton Pass, vault `Nik`, item `.env`, referenced as `pass://Nik/.env/<FIELD>`; never exported globally, never written to a tracked file, never printed",
      "**Default / protected branches**: main (default); no rulesets or branch protection listed on nikbrunner/dots",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (nikbrunner/dots, remotes `origin` github.com:nikbrunner/dots.git and `codeberg` ssh://codeberg.org/nbr/dots.git) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: dinky.rodeo, code.claude.com, api.github.com, www.superlogical.com — hosts contacted routinely in this project's session transcripts",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar.",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development, dotfiles and developer tooling (personal/hobby use)",
      "**Trusted repo**: nikbrunner/dots (this repo's working directory and its remotes `origin`/`codeberg`); PUBLIC — only this repo's own work belongs here, ported/repointed content from elsewhere is not its own work",
      "**Org-specific CLIs**: rex, dinky, defi, dots, wt, elevenlabs, tanstack, ghostty — non-standard CLIs used routinely in this project's sessions",
      "routine under nikbrunner/ prefix: actions scoped to the nikbrunner/dots repo and its own tooling (dots, wt, rex) are routine; actions touching other orgs' repos are not"
    ]
  },
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754313915132
  },
  "mcpServers": {},
  "disabledMcpjsonServers": ["chrome-devtools"]
}
