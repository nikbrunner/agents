{
  "mcpServers": {
    "atlassian-rovo-mcp": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "fff": {
      "type": "stdio",
      "command": "/Users/brunner/.local/bin/fff-mcp",
      "args": [],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "chrome-devtools-mcp",
      "args": [
        "--isolated"
      ],
      "env": {}
    },
    "claude-design": {
      "type": "http",
      "url": "https://api.anthropic.com/v1/design/mcp"
    },
    "exa": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "EXA_API_KEY=$(pass-cli item view pass://Nik/.env/EXA_API_KEY) || exit 1; export EXA_API_KEY; exec exa-mcp-server"
      ],
      "env": {}
    },
    "superlogical": {
      "type": "http",
      "url": "https://www.superlogical.com/rex/community-mcp"
    },
    "details": {
      "type": "http",
      "url": "https://api.details.so/mcp"
    },
    "apple-music": {
      "type": "stdio",
      "command": "/Users/brunner/.local/bin/applemusic-mcp",
      "args": [
        "serve",
        "--level",
        "api"
      ],
      "env": {}
    },
    "FLUX": {
      "type": "http",
      "url": "https://mcp.bfl.ai"
    },
    "mobbin": {
      "type": "http",
      "url": "https://api.mobbin.com/mcp"
    }
  }
}
